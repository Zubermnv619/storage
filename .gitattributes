# Normalize line endings on checkout/commit.
#
# Scripts and sources must stay LF. A CRLF checkout of a .sh file breaks the
# shebang on Linux/WSL/macOS ("/usr/bin/env: 'bash\r': No such file or
# directory"), which is exactly the kind of clean-clone failure this repo is
# meant to avoid.
* text=auto
*.sh      text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.h       text eol=lf
Makefile  text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.dat     -text
